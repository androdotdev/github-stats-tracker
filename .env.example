# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/github-stats-tracker"

# GitHub OAuth — create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Webhook secret — set in your repo Settings > Webhooks > Add webhook
GITHUB_WEBHOOK_SECRET=""

# Shared secret for Vercel Cron job authorization
CRON_SECRET=""

# Node environment
NODE_ENV="development"

# Auth 
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000" 

BETTER_AUTH_SECRET="your_better_auth_secret_here"